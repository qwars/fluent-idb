{
  "name": "fluent-idb",
  "version": "1.0.0",
  "description": "Type-safe, fluent API wrapper for IndexedDB with batching and compression",
  "license": "MIT",
  "author": "Alexandr Selunin",
  "packageManager": "yarn@4.1.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/qwars/fluent-idb.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "indexeddb",
    "fluent",
    "typescript",
    "database",
    "browser"
  ]
}
